rules_version = '2';

// 터치게임 온라인 랭킹 보안 규칙
// 핵심: 클라이언트가 보낸 점수를 그대로 믿지 않고, 게임 규칙상 불가능한 조합을 서버가 거부한다.
// index.html 의 rankFlags() 와 같은 기준을 서버에서 다시 검사하는 구조다.
service cloud.firestore {
  match /databases/{database}/documents {

    // 필드 구성과 타입
    function wellFormed(r) {
      return r.keys().hasOnly(['name','stage','prestiges','dps','gold','kills','rp','at'])
          && r.keys().hasAll(['name','stage','prestiges','dps','gold','kills','rp','at'])
          && r.name is string && r.name.size() >= 2 && r.name.size() <= 16
          && r.stage is int && r.prestiges is int && r.kills is int
          && r.dps is number && r.gold is number && r.rp is number
          && r.stage >= 1 && r.prestiges >= 0 && r.dps >= 0 && r.gold >= 0 && r.kills >= 0;
    }

    // 게임 규칙상 불가능한 조합을 거른다
    function plausible(r) {
      return r.stage <= 500                                              // 최종 스테이지 상한
          && r.prestiges <= 200
          && r.kills >= r.stage - 1                                      // 진행하려면 그만큼은 잡아야 한다
          && (r.prestiges == 0 || r.stage >= 12 + 4 * (r.prestiges - 1)) // 환생 조건
          && r.dps <= math.pow(1.55, math.min(r.stage + 25, 500)) * 100  // 스테이지 대비 DPS 상한
          && r.gold <= math.pow(1.24, r.stage) * 35 * 1000000000000;     // 스테이지 대비 골드 상한
    }

    // rp 는 클라이언트 계산값을 쓰되, 스테이지·환생분보다 작거나
    // 터무니없이 부풀려진 값은 거부한다(로그항은 규칙 언어로 계산할 수 없다).
    function rpSane(r) {
      return r.rp >= r.stage * 10 + r.prestiges * 250
          && r.rp <= r.stage * 10 + r.prestiges * 250 + 20000;
    }

    // 기록 시각이 서버 시간과 크게 어긋나면 거부한다
    function freshAt(r) {
      return r.at is int
          && r.at <= request.time.toMillis() + 60000
          && r.at >= request.time.toMillis() - 300000;
    }

    // 30초에 한 번보다 자주 쓰지 못하게 한다
    function notTooFast(uid) {
      return !exists(/databases/$(database)/documents/ranks/$(uid))
          || request.time.toMillis()
             - get(/databases/$(database)/documents/ranks/$(uid)).data.at > 30000;
    }

    function validRecord(r) {
      return wellFormed(r) && plausible(r) && rpSane(r) && freshAt(r);
    }

    match /ranks/{uid} {
      // 순위표는 누구나 읽을 수 있다
      allow read: if true;

      // 쓰기는 본인 문서에만, 검증을 통과한 기록만
      allow create, update: if request.auth != null
                            && request.auth.uid == uid
                            && validRecord(request.resource.data)
                            && notTooFast(uid);

      // 삭제는 막는다(정리는 콘솔에서)
      allow delete: if false;
    }
  }
}
